<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- OnePlus 6 (enchilada) Android 17 bring-up sources.
       Device/vendor/kernel branches are bridge inputs and are not a claim
       that the Lineage 23.2 / vendor 22.2 trees are Android 17-ready as-is. -->

  <remote name="zhanfg"
          fetch="https://github.com/Zhanfg"
          sync-c="true"
          sync-j="4" />

  <remote name="lineage-oneplus-upstream"
          fetch="https://github.com/LineageOS"
          revision="refs/heads/lineage-23.2"
          sync-c="true"
          sync-j="4" />

  <!-- Device trees -->
  <project path="device/oneplus/enchilada"
           name="android_device_oneplus_enchilada"
           remote="zhanfg"
           revision="lineage-23.2" />
  <project path="device/oneplus/sdm845-common"
           name="android_device_oneplus_sdm845-common"
           remote="zhanfg"
           revision="lineage-23.2" />

  <!-- Required by android_device_oneplus_sdm845-common/lineage.dependencies.
       TODO: switch remote to zhanfg after Zhanfg/android_hardware_oneplus is forked. -->
  <project path="hardware/oneplus"
           name="android_hardware_oneplus"
           remote="lineage-oneplus-upstream"
           revision="lineage-23.2" />

  <!-- Proprietary vendor blobs: upstream currently exposes lineage-22.2. -->
  <project path="vendor/oneplus/enchilada"
           name="proprietary_vendor_oneplus_enchilada"
           remote="zhanfg"
           revision="lineage-22.2" />
  <project path="vendor/oneplus/sdm845-common"
           name="proprietary_vendor_oneplus_sdm845-common"
           remote="zhanfg"
           revision="lineage-22.2" />

  <!-- 4.19 bridge/reference kernel. Final target remains GKI 5.15. -->
  <project path="kernel/oneplus/sdm845"
           name="android_kernel_oneplus_sdm845"
           remote="zhanfg"
           revision="lineage-23.2-4.19" />

  <!-- Use our Evolution X forks for the components we intend to modify. -->
  <remove-project name="frameworks_base" />
  <project path="frameworks/base"
           name="frameworks_base"
           remote="zhanfg"
           revision="cnb"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" />

  <remove-project name="packages_apps_Settings" />
  <project path="packages/apps/Settings"
           name="packages_apps_Settings"
           remote="zhanfg"
           revision="cnb"
           groups="pdk-fs,pdk-cw-tvc,sysui-studio" />

  <remove-project name="packages_apps_Evolver" />
  <project path="packages/apps/Evolver"
           name="packages_apps_Evolver"
           remote="zhanfg"
           revision="cnb" />

  <remove-project name="vendor_evolution" />
  <project path="vendor/lineage"
           name="vendor_evolution"
           remote="zhanfg"
           revision="cnb" />
</manifest>
